<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
    <Dialog title="Stock Transfer" contentWidth="400px">
        <content>
            <form:SimpleForm layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Product"/>
                    <Text text="{dialogModel>/productName} ({dialogModel>/productCode})" />
                    
                    <Label text="Source Warehouse"/>
                    <Text text="{dialogModel>/warehouseName}" />

                    <Label text="Available Stock"/>
                    <Text text="{dialogModel>/availableQuantity} {dialogModel>/uom}" />
                    
                    <Label text="Target Inventory ID" required="true"/>
                    <Input value="{dialogModel>/targetInventoryId}" placeholder="Enter destination INV ID" />

                    <Label text="Quantity to Transfer" required="true"/>
                    <Input value="{dialogModel>/quantity}" type="Number" />
                    
                    <Label text="Reference"/>
                    <Input value="{dialogModel>/reference}" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Post Transfer" type="Emphasized" press=".onConfirmStockTransfer" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelStockTransfer" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
