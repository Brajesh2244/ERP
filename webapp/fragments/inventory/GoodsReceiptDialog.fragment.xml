<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
    <Dialog title="Goods Receipt" contentWidth="400px">
        <content>
            <form:SimpleForm layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Product"/>
                    <Text text="{dialogModel>/productName} ({dialogModel>/productCode})" />
                    
                    <Label text="Warehouse"/>
                    <Text text="{dialogModel>/warehouseName}" />

                    <Label text="Quantity to Receive" required="true"/>
                    <Input value="{dialogModel>/quantity}" type="Number" />
                    
                    <Label text="Reference (PO/ASN)"/>
                    <Input value="{dialogModel>/reference}" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Post Receipt" type="Emphasized" press=".onConfirmGoodsReceipt" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelGoodsReceipt" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
