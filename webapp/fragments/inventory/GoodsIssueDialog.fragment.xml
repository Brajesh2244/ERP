<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core" xmlns:form="sap.ui.layout.form">
    <Dialog title="Goods Issue" contentWidth="400px">
        <content>
            <form:SimpleForm layout="ResponsiveGridLayout">
                <form:content>
                    <Label text="Product"/>
                    <Text text="{dialogModel>/productName} ({dialogModel>/productCode})" />
                    
                    <Label text="Available Stock"/>
                    <Text text="{dialogModel>/availableQuantity} {dialogModel>/uom}" />

                    <Label text="Quantity to Issue" required="true"/>
                    <Input value="{dialogModel>/quantity}" type="Number" />
                    
                    <Label text="Reference (SO/Cost Center)"/>
                    <Input value="{dialogModel>/reference}" />
                </form:content>
            </form:SimpleForm>
        </content>
        <beginButton>
            <Button text="Post Issue" type="Emphasized" press=".onConfirmGoodsIssue" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelGoodsIssue" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
