<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">
    <Dialog title="Confirm Deletion" type="Message" state="Warning">
        <content>
            <Text text="Are you sure you want to delete this employee? This action cannot be undone." />
        </content>
        <beginButton>
            <Button text="Delete" type="Reject" press=".onConfirmDelete" />
        </beginButton>
        <endButton>
            <Button text="Cancel" press=".onCancelDelete" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>
