<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.f">
    <f:Card width="300px">
        <f:header>
            <f:CardHeader title="{employeeModel>FirstName} {employeeModel>LastName}" subtitle="{employeeModel>Designation}" iconSrc="{employeeModel>ProfileImage}" />
        </f:header>
        <f:content>
            <VBox class="sapUiSmallMargin">
                <HBox justifyContent="SpaceBetween">
                    <Label text="Department:" />
                    <Text text="{employeeModel>Department}" />
                </HBox>
                <HBox justifyContent="SpaceBetween">
                    <Label text="Status:" />
                    <ObjectStatus text="{employeeModel>Status}" state="{= ${employeeModel>Status} === 'Active' ? 'Success' : (${employeeModel>Status} === 'On Leave' ? 'Warning' : 'Error') }"/>
                </HBox>
            </VBox>
        </f:content>
    </f:Card>
</core:FragmentDefinition>
