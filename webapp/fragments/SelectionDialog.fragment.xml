<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
    <SelectDialog
        id="idSelectionDialog"
        title="Select Item"
        multiSelect="true"
        search=".onSelectionSearch"
        confirm=".onSelectionConfirm"
        cancel=".onSelectionCancel"
        items="{/items}">
        <StandardListItem title="{name}" description="{id}" />
    </SelectDialog>
</core:FragmentDefinition>
