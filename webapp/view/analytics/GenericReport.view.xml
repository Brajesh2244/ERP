<mvc:View controllerName="sap.erm.app.controller.analytics.GenericReport" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="{viewMode>/title}" level="H2"/>
                </f:heading>
                <f:actions>
                    <Button icon="sap-icon://excel-attachment" text="Export" press=".onExportPress" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <VBox>
                <!-- Global Filter Bar placeholder -->
                <core:Fragment fragmentName="sap.erm.app.fragments.GenericTable" type="XML" />
            </VBox>
        </f:content>
    </f:DynamicPage>
</mvc:View>
