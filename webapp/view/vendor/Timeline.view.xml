<mvc:View controllerName="sap.erm.app.controller.vendor.Timeline" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Vendor Activity Timeline: {model>/vendorName}" level="H2"/>
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <List>
                <FeedListItem sender="{model>/updatedBy}" icon="sap-icon://edit" text="Vendor details were recently updated." timestamp="{model>/updatedDate}" />
                <FeedListItem sender="{model>/createdBy}" icon="sap-icon://add-contact" text="Vendor {model>/vendorName} was created." timestamp="{model>/createdDate}" />
            </List>
        </f:content>
    </f:DynamicPage>
</mvc:View>
