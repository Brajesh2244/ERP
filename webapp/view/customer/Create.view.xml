<mvc:View controllerName="sap.erm.app.controller.customer.Create" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:form="sap.ui.layout.form" xmlns:core="sap.ui.core">
    <f:DynamicPage showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Create Customer" level="H2"/>
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <form:SimpleForm layout="ResponsiveGridLayout" title="Customer Details">
                <form:content>
                    <core:Title text="General" />
                    <Label text="Company Name" required="true"/>
                    <Input value="{model>/companyName}" />
                    
                    <Label text="Legal Name"/>
                    <Input value="{model>/legalName}" />
                    
                    <Label text="Customer Type"/>
                    <ComboBox selectedKey="{model>/customerType}">
                        <core:Item key="B2B" text="B2B" />
                        <core:Item key="B2C" text="B2C" />
                    </ComboBox>
                    
                    <Label text="Category"/>
                    <ComboBox selectedKey="{model>/categoryId}" items="{customerCategoryModel>/}">
                        <core:Item key="{customerCategoryModel>id}" text="{customerCategoryModel>name}" />
                    </ComboBox>
                    
                    <Label text="Industry"/>
                    <ComboBox selectedKey="{model>/industryId}" items="{industryModel>/}">
                        <core:Item key="{industryModel>id}" text="{industryModel>name}" />
                    </ComboBox>

                    <core:Title text="Contact" />
                    <Label text="Primary Contact" required="true"/>
                    <Input value="{model>/primaryContact}" />
                    
                    <Label text="Email" required="true"/>
                    <Input value="{model>/email}" />
                    
                    <Label text="Phone"/>
                    <Input value="{model>/phone}" />
                    
                    <core:Title text="Financial" />
                    <Label text="Credit Limit"/>
                    <Input value="{model>/creditLimit}" type="Number" />
                    
                    <Label text="Currency"/>
                    <ComboBox selectedKey="{model>/currencyId}" items="{currencyModel>/}">
                        <core:Item key="{currencyModel>id}" text="{currencyModel>name}" />
                    </ComboBox>
                    
                    <Label text="Payment Terms"/>
                    <ComboBox selectedKey="{model>/paymentTermsId}" items="{paymentTermsModel>/}">
                        <core:Item key="{paymentTermsModel>id}" text="{paymentTermsModel>name}" />
                    </ComboBox>

                    <core:Title text="Address" />
                    <Label text="Country"/>
                    <ComboBox selectedKey="{model>/countryId}" items="{countryModel>/}">
                        <core:Item key="{countryModel>id}" text="{countryModel>name}" />
                    </ComboBox>

                    <Label text="State"/>
                    <ComboBox selectedKey="{model>/stateId}" items="{stateModel>/}">
                        <core:Item key="{stateModel>id}" text="{stateModel>name}" />
                    </ComboBox>
                </form:content>
            </form:SimpleForm>
        </f:content>
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Save" type="Emphasized" press=".onSavePress" />
                <Button text="Cancel" press=".onNavBack" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
