<mvc:View
    controllerName="sap.erm.app.controller.employee.Edit"
    xmlns:mvc="sap.ui.core.mvc"
    xmlns="sap.m"
    xmlns:f="sap.f"
    xmlns:form="sap.ui.layout.form">
    <f:DynamicPage showFooter="true">
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Edit Employee" level="H2"/>
                </f:heading>
                <f:navigationActions>
                    <Button icon="sap-icon://nav-back" type="Transparent" press=".onNavBack" />
                </f:navigationActions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <form:SimpleForm layout="ResponsiveGridLayout" title="Employee Details">
                <form:content>
                    <Label text="First Name" required="true"/>
                    <Input value="{model>/firstName}" />
                    
                    <Label text="Last Name" required="true"/>
                    <Input value="{model>/lastName}" />
                    
                    <Label text="Email" required="true"/>
                    <Input value="{model>/email}" />
                    
                    <Label text="Phone" />
                    <Input value="{model>/phone}" />
                    
                    <Label text="Department" />
                    <Input value="{model>/department}" />
                    
                    <Label text="Designation" />
                    <Input value="{model>/designation}" />
                    
                    <Label text="Role" />
                    <Input value="{model>/role}" />
                </form:content>
            </form:SimpleForm>
        </f:content>
        <f:footer>
            <OverflowToolbar>
                <ToolbarSpacer />
                <Button text="Save Changes" type="Emphasized" press=".onSavePress" />
                <Button text="Cancel" press=".onNavBack" />
            </OverflowToolbar>
        </f:footer>
    </f:DynamicPage>
</mvc:View>
