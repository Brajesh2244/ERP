<mvc:View controllerName="sap.erm.app.controller.inventory.Dashboard" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core" xmlns:layout="sap.ui.layout">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Warehouse Operations Dashboard" level="H2"/>
                </f:heading>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <layout:Grid defaultSpan="XL3 L4 M6 S12">
                <f:Card>
                    <f:header>
                        <f:CardHeader title="Total Inventory Value" subtitle="Current Stock Value" iconSrc="sap-icon://money-bills"/>
                    </f:header>
                    <f:content>
                        <FlexBox alignItems="Center" justifyContent="Center" height="100px">
                            <Title text="$ {model>/totalValue}" titleStyle="H1" />
                        </FlexBox>
                    </f:content>
                </f:Card>

                <f:Card>
                    <f:header>
                        <f:CardHeader title="Low Stock Alerts" subtitle="Items below reorder level" iconSrc="sap-icon://alert" statusText="{model>/lowStockCount}"/>
                    </f:header>
                    <f:content>
                        <List items="{model>/lowStockItems}">
                            <StandardListItem title="{model>productName}" description="{model>warehouseName}" info="{model>availableQuantity} {model>uom}" infoState="Warning" />
                        </List>
                    </f:content>
                </f:Card>

                <f:Card>
                    <f:header>
                        <f:CardHeader title="Out of Stock" subtitle="Zero available quantity" iconSrc="sap-icon://error" statusText="{model>/outOfStockCount}"/>
                    </f:header>
                    <f:content>
                        <List items="{model>/outOfStockItems}">
                            <StandardListItem title="{model>productName}" description="{model>warehouseName}" info="{model>availableQuantity} {model>uom}" infoState="Error" />
                        </List>
                    </f:content>
                </f:Card>

                <f:Card>
                    <f:header>
                        <f:CardHeader title="Recent Movements" subtitle="Last 5 Transactions" iconSrc="sap-icon://history"/>
                    </f:header>
                    <f:content>
                        <List items="{model>/recentMovements}">
                            <StandardListItem title="{model>type}" description="{model>productId}" info="{model>quantity}" infoState="{= ${model>quantity} > 0 ? 'Success' : 'Error' }" />
                        </List>
                    </f:content>
                </f:Card>
            </layout:Grid>
        </f:content>
    </f:DynamicPage>
</mvc:View>
