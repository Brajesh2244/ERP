<mvc:View controllerName="sap.erm.app.controller.sales.List" xmlns:mvc="sap.ui.core.mvc" xmlns="sap.m" xmlns:f="sap.f" xmlns:core="sap.ui.core">
    <f:DynamicPage>
        <f:title>
            <f:DynamicPageTitle>
                <f:heading>
                    <Title text="Sales Orders" level="H2"/>
                </f:heading>
                <f:actions>
                    <Button text="Create" type="Emphasized" press=".onCreatePress" />
                </f:actions>
            </f:DynamicPageTitle>
        </f:title>
        <f:content>
            <core:Fragment fragmentName="sap.erm.app.fragments.GenericTable" type="XML" />
        </f:content>
    </f:DynamicPage>
</mvc:View>
